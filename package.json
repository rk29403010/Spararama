{
  "name": "spararama",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','server.js']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "pnpm run test:app && pnpm run test:cleverspa && pnpm run test:alexa",
    "test:app": "tsx test/run.ts",
    "test:cleverspa": "pnpm --dir services/cleverspa test",
    "test:alexa": "node --test services/alexa/handler.test.mjs && node --check services/alexa/local-proxy.mjs",
    "cleverspa:start": "node --env-file-if-exists=.env services/cleverspa/src/server.js",
    "cleverspa:dev": "node --env-file-if-exists=.env --watch services/cleverspa/src/server.js",
    "firebase:diagnose": "tsx scripts/diagnose-firebase.ts",
    "local": "node scripts/local.mjs",
    "local:update": "node scripts/local.mjs update",
    "local:sync": "node scripts/local.mjs sync",
    "local:start": "node scripts/local.mjs start",
    "local:stop": "node scripts/local.mjs stop",
    "local:restart": "node scripts/local.mjs restart",
    "local:status": "node scripts/local.mjs status"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.23.24",
    "openmeteo": "^1.2.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
