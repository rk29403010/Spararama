{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "firestore": [
    {
      "database": "ai-studio-hottubmonitor-c4b572e9-4270-488c-b8d2-306ccf453f65",
      "indexes": "firestore.indexes.json",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "dist/cloud-web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "spararama-cloud-control",
          "region": "europe-west2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
