# Optional Gemini image-analysis calls. Requests are authenticated local operations,
# rate-limited, validated as real JPEG/PNG/WebP images and bounded after base64 decode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_ANALYSIS_MAX_IMAGE_BYTES="5242880"
GEMINI_ANALYSIS_REQUESTS_PER_MINUTE="6"
APP_URL="MY_APP_URL"

# Browser Firebase configuration - not a privileged server credential.
# The original project values remain code defaults for backwards compatibility,
# but fresh hosted deployments should provide the complete browser config.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIRESTORE_DATABASE_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Browser runtime. Normal LAN/phone builds leave this as local. The dedicated
# cloud:web:build command forces cloud mode and normally uses same-origin /api.
VITE_SPARARAMA_RUNTIME="local"
VITE_SPARARAMA_CLOUD_API_BASE=""

# --- Local server / physical-control boundary ---
# Safe default: the backend listens only on loopback. Prefer Caddy/another HTTPS
# reverse proxy for access from phones/laptops rather than exposing port 3000.
SPAR_BIND_HOST="127.0.0.1"
# Direct loopback mutations are the trusted offline/recovery path. Proxied/LAN
# spa, heating, push and billable image-analysis mutations require a signed-in
# owner/member. Existing Firebase remote-control membership for
# REMOTE_INSTALLATION_ID is reused when configured.
# These explicit local lists are useful for installs that do not use remote control.
SPAR_LOCAL_CONTROL_OWNER_UIDS=""
SPAR_LOCAL_CONTROL_OWNER_EMAILS=""
SPAR_LOCAL_CONTROL_MEMBER_UIDS=""
SPAR_LOCAL_CONTROL_MEMBER_EMAILS=""
SPAR_LOCAL_CONTROL_VIEWER_UIDS=""
SPAR_LOCAL_CONTROL_VIEWER_EMAILS=""
# Existing SPARARAMA_ADMIN_UID/SPARARAMA_ADMIN_EMAILS entries also count as owners.
# Sessions are signed with a random secret stored under this untracked directory;
# the default 30-day lifetime keeps LAN control available through cloud outages.
SPAR_LOCAL_AUTH_DIR="./data/local-auth"
SPAR_LOCAL_CONTROL_SESSION_HOURS="720"
# Unsafe escape hatch for deliberately exposed plain-HTTP LAN installs. Leave off;
# authenticated LAN control should normally arrive through HTTPS.
SPAR_LOCAL_CONTROL_ALLOW_INSECURE_HTTP="0"

# --- Water-body hardware adapter ---
# bridge/cleverspa = bundled CleverSpa service; manual/none = no hardware link;
# mock = development simulator. Other brands can add further SpaAdapter implementations.
SPA_ADAPTER="bridge"
CLEVERSPA_BRIDGE_URL="http://127.0.0.1:8787"
# Leave empty for the normal loopback-only local deployment. If the adapter is
# deliberately exposed on a private LAN, use the same long token in both fields.
CLEVERSPA_BRIDGE_TOKEN=""
CLEVERSPA_SERVICE_TOKEN=""
CLEVERSPA_SERVICE_HOST="127.0.0.1"
CLEVERSPA_SERVICE_PORT="8787"
# Optional direct known-device values; normal operation may discover the spa instead.
CLEVERSPA_IP=""
CLEVERSPA_PASSCODE=""

# --- Always-on local collector ---
# Config screen changes are persisted locally after this initial default.
TELEMETRY_INTERVAL_SECONDS="300"
# Must identify this collector installation, not the person/account. Do not copy
# the same value to another always-on machine. Omit it to use the machine hostname.
TELEMETRY_HOST_ID="spararama-laptop"
TELEMETRY_DIR="./data/telemetry"
# Sparse state snapshots and weather forecast revision cadence.
TELEMETRY_SNAPSHOT_INTERVAL_SECONDS="86400"
TELEMETRY_FORECAST_INTERVAL_SECONDS="3600"
# Shared history reads Firebase at most this often and caches the result locally
# in data/telemetry/remote-cache.ndjson for offline use.
SHARED_TELEMETRY_REFRESH_SECONDS="300"

# --- Optional Meross MSH300 / MS100 environmental sensors ---
# Direct LAN polling stays local and feeds the normal durable telemetry archive.
# Give the hub a stable DHCP lease, then set its host/IP. Leave the key empty to
# use Meross's read-only LAN reply-key exchange. If a firmware rejects that mode,
# set the Meross account's device key here and keep it in the untracked .env only.
MEROSS_MSH300_HOST=""
MEROSS_MSH300_KEY=""
MEROSS_MSH300_TIMEOUT_MS="5000"
# Optional subdevice ID -> friendly location mapping, for example:
# MEROSS_MS100_LABELS_JSON='{"01234567":"Beside spa","89ABCDEF":"Garden"}'
MEROSS_MS100_LABELS_JSON=""

# --- Optional Ecowitt local weather station ---
# GW3000/GW3010-class gateways expose live data directly over the LAN. When set,
# current conditions come from Ecowitt while Open-Meteo remains the forecast source.
# Give the gateway a stable DHCP lease and set only its host/IP (no path required).
ECOWITT_HOST=""
ECOWITT_TIMEOUT_MS="5000"
# Shared short cache prevents the weather and generic-sensor collectors making
# duplicate live-data requests during the same telemetry cycle.
ECOWITT_CACHE_MS="5000"
ECOWITT_LOCATION_LABEL="Garden weather station"

# Firebase upload/read-through is optional. Local telemetry continues when disabled/offline.
FIREBASE_TELEMETRY_ENABLED="false"
FIREBASE_PROJECT_ID="microprojects-481213"
FIRESTORE_DATABASE_ID="ai-studio-hottubmonitor-c4b572e9-4270-488c-b8d2-306ccf453f65"
# Firebase Admin authentication. Keep this credential OUTSIDE the repository.
# Used by telemetry, FCM push, Firebase ID-token verification and Secret Manager.
# GOOGLE_APPLICATION_CREDENTIALS="C:\\Users\\YOUR_NAME\\.spararama\\credentials\\firebase-admin.json"

# --- Optional remote access/control plane ---
# Safe default: no cloud command transport. Local UI/control remains fully usable.
# Set to "firebase" on an always-on local node to enable the reference outbound-only
# command/state channel using the same Firebase Admin target/credential above.
REMOTE_TRANSPORT="none"
# Stable installation identity for the remote control plane. Required for Firebase;
# do not reuse one ID for two physical installations. Local LAN auth also reuses
# owner/member/viewer membership for this installation when it is configured.
REMOTE_INSTALLATION_ID=""
# Local durable command idempotency ledger. Keep outside source control.
REMOTE_STATE_DIR="./data/remote"
# Current-state/presence heartbeat and command claim lease.
REMOTE_HEARTBEAT_SECONDS="30"
REMOTE_COMMAND_LEASE_MS="60000"

# Cloud control service settings. These apply to the separately deployable public
# API, not to ordinary local-only installs. Prefer same-origin hosting/proxying;
# list explicit browser origins only when intentionally calling the API cross-origin.
REMOTE_CLOUD_COMMANDS_PER_MINUTE="30"
REMOTE_CLOUD_STALE_AFTER_MS="90000"
REMOTE_CLOUD_OFFLINE_AFTER_MS="300000"
SPARARAMA_CLOUD_ALLOWED_ORIGINS=""

# Owner/admin identities. These entries grant local-control owner role and may
# administer stored Alexa credentials. Alexa credential routes fail closed when
# the signed-in user is not an owner; alternatively an owner role can come from
# SPAR_LOCAL_CONTROL_OWNER_* or REMOTE_INSTALLATION_ID membership.
SPARARAMA_ADMIN_UID=""
SPARARAMA_ADMIN_EMAILS=""

# --- Background phone/browser notifications (Firebase Cloud Messaging) ---
# Requires HTTPS (localhost is permitted for development), the browser Firebase
# API key above, a Web Push certificate/VAPID public key from Firebase Console,
# and Firebase Admin credentials via GOOGLE_APPLICATION_CREDENTIALS/ADC.
FIREBASE_PUSH_ENABLED="false"
FIREBASE_WEB_PUSH_VAPID_KEY="YOUR_PUBLIC_VAPID_KEY"
PUSH_REGISTRATION_DIR="./data/push"
# Registration mutations require the authenticated local-control boundary. These
# caps additionally prevent persistent registry growth even if a route regresses.
PUSH_MAX_REGISTRATIONS="20"
PUSH_REGISTRY_MAX_BYTES="262144"

# --- Direct Alexa voice control (disabled until deliberately exposed/tested) ---
# Alexa Smart Home uses AWS Lambda; services/alexa/handler.mjs forwards only to
# this protected endpoint. Never expose the CleverSpa adapter itself publicly.
ALEXA_DIRECT_ENABLED="false"
ALEXA_DIRECT_PROXY_SECRET=""
ALEXA_SKILL_ID=""
SPARARAMA_TIME_ZONE="Europe/London"

# Stable Alexa path through the cloud control plane. Leave disabled until the
# managed cloud API has been deployed and validated end to end.
ALEXA_CLOUD_ENABLED="false"
ALEXA_CLOUD_INSTALLATION_ID=""
ALEXA_CLOUD_INTEGRATION_SECRET=""
# Heater starts first enable filtration and wait for its flow interlock. Leave enough
# time for the home agent to confirm that two-step operation to Alexa.
ALEXA_CLOUD_COMMAND_TIMEOUT_MS="10000"
# Ready-time planning uses the same src/domain/heating.ts calculation as the app,
# including WeatherService forecast/influence data. These server-side physical
# defaults mirror the current 800 L CleverSpa app profile and can be overridden.
# Leave target blank to use the spa's current target setpoint.
ALEXA_DEFAULT_READY_TARGET_C=""
ALEXA_HEATING_RATE_C_PER_HOUR="1.5"
ALEXA_WATER_VOLUME_LITERS="800"
ALEXA_HEATING_RATE_REFERENCE_VOLUME_LITERS="800"
ALEXA_HEAT_SOAK_MINUTES="30"
ALEXA_HEATER_POWER_WATTS="1800"
ALEXA_ELECTRICITY_RATE_PER_KWH="0.2086"

# --- Alexa announcements (Voice Monkey v3) ---
# Voice Monkey remains active while the direct Alexa path is being validated.
# Preferred storage is Google Cloud Secret Manager in the Firebase/GCP project.
# The Settings page writes a JSON secret containing enabled/token/device/chime;
# the stored API key is never returned to the browser. The server credential needs
# Secret Manager access (and create/add-version permission for first-time setup).
VOICE_MONKEY_SECRET_ID="spararama-voice-monkey"

# Legacy/environment fallback. Useful for recovery or installations that do not
# use Secret Manager. Never commit a real Voice Monkey token to this repository.
VOICE_MONKEY_ENABLED="false"
VOICE_MONKEY_TOKEN=""
# Stable Speaker device ID returned by the Voice Monkey /devices API.
VOICE_MONKEY_DEVICE=""
VOICE_MONKEY_CHIME=""
ALERT_DELIVERY_DIR="./data/alerts"