# Optional Gemini image-analysis calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Browser Firebase configuration - not a privileged server credential.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"

# --- Water-body hardware adapter ---
# bridge/cleverspa = bundled CleverSpa service; manual/none = no hardware link;
# mock = development simulator. Other brands can add further SpaAdapter implementations.
SPA_ADAPTER="bridge"
CLEVERSPA_BRIDGE_URL="http://127.0.0.1:8787"
# Leave empty for the normal loopback-only local deployment. If the adapter is
# deliberately exposed on a private LAN, use the same long token in both fields.
CLEVERSPA_BRIDGE_TOKEN=""
CLEVERSPA_SERVICE_TOKEN=""
CLEVERSPA_SERVICE_HOST="127.0.0.1"
CLEVERSPA_SERVICE_PORT="8787"
# Optional direct known-device values; normal operation may discover the spa instead.
CLEVERSPA_IP=""
CLEVERSPA_PASSCODE=""

# --- Always-on local collector ---
# Config screen changes are persisted locally after this initial default.
TELEMETRY_INTERVAL_SECONDS="300"
TELEMETRY_HOST_ID="spararama-laptop"
TELEMETRY_DIR="./data/telemetry"

# Firebase upload is optional. Local telemetry continues when disabled/offline.
FIREBASE_TELEMETRY_ENABLED="false"
FIREBASE_PROJECT_ID="microprojects-481213"
FIRESTORE_DATABASE_ID="ai-studio-hottubmonitor-c4b572e9-4270-488c-b8d2-306ccf453f65"
# Firebase Admin authentication. Keep this credential OUTSIDE the repository.
# Used by telemetry, FCM push, Firebase ID-token verification and Secret Manager.
# GOOGLE_APPLICATION_CREDENTIALS="C:\\Users\\YOUR_NAME\\.spararama\\credentials\\firebase-admin.json"

# Optional restriction for credential-changing settings endpoints. If neither is
# set, any Firebase-authenticated Spararama user can change Alexa credentials.
SPARARAMA_ADMIN_UID=""
SPARARAMA_ADMIN_EMAILS=""

# --- Background phone/browser notifications (Firebase Cloud Messaging) ---
# Requires HTTPS (localhost is permitted for development), the browser Firebase
# API key above, a Web Push certificate/VAPID public key from Firebase Console,
# and Firebase Admin credentials via GOOGLE_APPLICATION_CREDENTIALS/ADC.
FIREBASE_PUSH_ENABLED="false"
FIREBASE_WEB_PUSH_VAPID_KEY="YOUR_PUBLIC_VAPID_KEY"
PUSH_REGISTRATION_DIR="./data/push"

# --- Alexa announcements (Voice Monkey v3) ---
# Preferred storage is Google Cloud Secret Manager in the Firebase/GCP project.
# The Settings page writes a JSON secret containing enabled/token/device/chime;
# the stored API key is never returned to the browser. The server credential needs
# Secret Manager access (and create/add-version permission for first-time setup).
VOICE_MONKEY_SECRET_ID="spararama-voice-monkey"

# Legacy/environment fallback. Useful for recovery or installations that do not
# use Secret Manager. Never commit a real Voice Monkey token to this repository.
VOICE_MONKEY_ENABLED="false"
VOICE_MONKEY_TOKEN=""
VOICE_MONKEY_DEVICE=""
VOICE_MONKEY_CHIME=""
ALERT_DELIVERY_DIR="./data/alerts"
