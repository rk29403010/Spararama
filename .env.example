# GEMINI_API_KEY: Required only for optional Gemini image-analysis calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional deployed application URL.
APP_URL="MY_APP_URL"

# Browser Firebase API key. This is normal Firebase web configuration, not a privileged server credential.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"

# --- Always-on local collector ---
# bridge = use the CleverSpa recovery service on localhost; mock = development simulator.
SPA_ADAPTER="bridge"
CLEVERSPA_BRIDGE_URL="http://127.0.0.1:8787"
# Only needed if the recovery bridge was configured with an access token.
CLEVERSPA_BRIDGE_TOKEN=""

# Initial modelling phase: sample real spa state every 30 seconds.
TELEMETRY_INTERVAL_SECONDS="30"
# Stable ID for the machine doing the collecting. Defaults to the computer hostname.
TELEMETRY_HOST_ID="spararama-laptop"
# Local append-only archive + retry queue live under this directory.
TELEMETRY_DIR="./data/telemetry"

# Firebase upload is optional. Local archive continues even when disabled/offline.
FIREBASE_TELEMETRY_ENABLED="false"
FIREBASE_PROJECT_ID="microprojects-481213"
FIRESTORE_DATABASE_ID="ai-studio-hottubmonitor-c4b572e9-4270-488c-b8d2-306ccf453f65"
# For local Firebase Admin authentication, set GOOGLE_APPLICATION_CREDENTIALS to
# the absolute path of a service-account JSON file kept OUTSIDE this repository.
# GOOGLE_APPLICATION_CREDENTIALS="C:\\private\\spararama-firebase-service-account.json"
