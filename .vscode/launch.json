{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Spararama app - API + frontend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
      "args": [
        "${workspaceFolder}/server.ts"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "Server running on (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "CleverSpa adapter",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env"
      ],
      "program": "${workspaceFolder}/services/cleverspa/src/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Spararama app - manual/no hardware",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
      "args": [
        "${workspaceFolder}/server.ts"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development",
        "SPA_ADAPTER": "manual"
      },
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "Server running on (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Spararama - full local stack",
      "configurations": [
        "CleverSpa adapter",
        "Spararama app - API + frontend"
      ],
      "stopAll": true
    }
  ]
}
